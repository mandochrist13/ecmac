
generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")

  
}

model Utilisateur {
  id     Int    @id @default(autoincrement())
  nom      String
  email    String @unique
  password String
  role     String @default("user") // 'admin' ou 'user'
  createdAt DateTime @default(now())
}
              
model Filiere {
  id     Int    @id @default(autoincrement())
  nom    String
  niveau String
}

model Hero {
  id       Int    @id @default(autoincrement())
  titre    String
  sousTitre String
  imageUrl String
}

model Calendrier {
  id     Int    @id @default(autoincrement())
  date   DateTime
  evenement String
}

model Actualite {
  id      Int    @id @default(autoincrement())
  titre   String
  contenu String
  imageUrl String?
  date    DateTime
}

model Galerie {
  id       Int    @id @default(autoincrement())
  imageUrl String
  description String?
}

model Preinscription {
  id                       Int      @id @default(autoincrement())
  nom                      String
  prenom                   String
  email                    String
  telephone                String
  etablissementDeProvenance String

  filiere                  String
  niveau                   String

  actdeNaissanceUrl        String
  photoUrl                 String
  bulletinUrl              String

  createdAt                DateTime @default(now())

  @@index([email])         // accélère les requêtes par email
  @@index([createdAt])     // accélère les tris ou filtres par date
}


model Banniere {
  id        Int      @id @default(autoincrement())
  titre     String
  sousTitre String?
  imageUrl  String
  lien      String?      // Lien optionnel vers une page
  ordre     Int          // Pour gérer l’ordre d’affichage (ex : 1er, 2e, etc.)
  actif     Boolean @default(true) // Pour afficher ou cacher une bannière
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}





